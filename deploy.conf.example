# Config for deploy.sh (shell KEY=VALUE syntax).
# Copy to deploy.conf (-c) or to ~/.config/openwrt-scripts/deploy.conf
# (the default; dotfiles renders it from its private toml) and adjust.

# Local directory with the files to deploy
# (default: deploy/ next to the script)
#DEPLOY_DIR="./deploy"

# Remote directory the top-level files land in (default: /usr/bin). Files in
# subdirectories ignore DEST_DIR and mirror the device root fs instead:
# deploy/etc/config/foo -> /etc/config/foo.
DEST_DIR="/usr/bin"

# Extra ssh options
SSH_OPTS="-o ConnectTimeout=10"

# Host-to-files map: one entry per line —
#   <[user@]host> <file|glob>[:mode][@boot][@keep]...
# Hosts are anything ssh accepts, incl. ~/.ssh/config aliases. Patterns are
# shell globs relative to DEPLOY_DIR ('*' = every top-level file; files in a
# subdirectory need an explicit 'subdir/*'). The optional ':mode' sets octal
# permissions for every file the pattern matches (e.g. 'secret.conf:600');
# without it the local executable bit decides: executable -> 755, else 644.
# The optional '@boot' registers the deployed file in /etc/rc.local so it
# runs at boot (inserted once before the final 'exit 0'; re-deploys do not
# duplicate the line). The optional '@keep' adds it to /etc/sysupgrade.conf
# so it is included in sysupgrade backups and survives firmware upgrades —
# for @boot scripts outside /etc you usually want '@boot@keep', otherwise
# the rc.local entry survives the upgrade but the script does not.
# '#' starts a comment; several lines for the same host accumulate.
DEPLOY="
rtr1-gl-mt6000  setup-clash-cache.sh@boot@keep patch-fw4-offload.sh@boot@keep
rtr2            *                # everything from DEPLOY_DIR
root@10.0.0.3   patch-fw4-offload.sh@boot@keep etc/config/*:600
"
