# Config for update-openvpn-password.sh (shell KEY=VALUE syntax).
# Copy to update-openvpn-password.conf and adjust.

# [user@]host of the OpenWrt device (anything ssh accepts, incl. ~/.ssh/config aliases)
HOST="root@host"

# Name of the network interface with proto 'openvpn' (luci-proto-openvpn).
# Find it on the device with:  uci show network | grep "proto='openvpn'"
IFACE="vpn"

# Optional: also update option 'username' (leave empty to keep the current one)
USERNAME=""

# Optional: shell command that prints the new password on its first stdout
# line, e.g. a password manager lookup. Used when -p is not given; leave
# empty to be prompted interactively (or pipe the password via stdin).
#PASSWORD_CMD="pass show vpn/rtr1"
PASSWORD_CMD=""

# Seconds to wait for the interface to come up after the restart; 0 = don't wait
WAIT=30
