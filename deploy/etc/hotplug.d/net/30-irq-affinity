#!/bin/sh
# =============================================================================
# Universal IRQ affinity setup for OpenWrt with per-device profiles.
#
# Install as: /etc/hotplug.d/net/30-irq-affinity  (chmod +x)
# Runs when network interfaces appear, i.e. after IRQs are registered.
#
# Adding a new device = adding one section to the "case" block below:
#   1. Get the board name:        cat /tmp/sysinfo/board_name
#   2. Inspect interrupt names:   cat /proc/interrupts
#   3. Add a profile with set_aff calls (pattern, hex CPU mask, [match #]).
#
# CPU mask reference (hex bitmask): CPU0=1, CPU1=2, CPU2=4, CPU3=8,
# combinations allowed (e.g. 3 = CPU0+CPU1), but note that a hardware IRQ
# is still serviced by only ONE core at a time even with a multi-bit mask.
#
# Verification after boot:
#   logread | grep irq-affinity
#   grep -E '<pattern>' /proc/interrupts; sleep 10; grep -E '<pattern>' /proc/interrupts
#   (counters must grow in the target CPU column under load)
#
# Note: restarting SQM resets affinity. To re-apply manually:
#   rm /tmp/.irq-affinity-done && sh /etc/hotplug.d/net/30-irq-affinity
# =============================================================================

# Run only once per boot (hotplug fires for every interface event).
# The lock lives in /tmp, which is cleared on reboot; it is taken right
# away so concurrent events and boards without a profile do not re-enter
# (and do not spam the log on every interface event).
LOCK="/tmp/.irq-affinity-done"
[ -e "$LOCK" ] && exit 0
touch "$LOCK"

BOARD="$(cat /tmp/sysinfo/board_name 2>/dev/null)"
# grep -c exits non-zero on zero matches/missing file; treat as single-core
NCPU="$(grep -c ^processor /proc/cpuinfo 2>/dev/null)" || NCPU=1

# IRQ affinity is pointless on a single-core system.
[ "$NCPU" -lt 2 ] && exit 0

log() { logger -t irq-affinity "$1"; }

# set_aff <grep -E pattern> <hex mask> [match number]
# Finds the Nth (default: 1st) IRQ whose /proc/interrupts line matches the
# pattern and writes the mask to its smp_affinity.
# Silently skips missing devices; reports managed IRQs that reject the mask.
set_aff() {
    sa_pattern=$1
    sa_mask=$2
    sa_nth=${3:-1}
    sa_irq=$(grep -E "$sa_pattern" /proc/interrupts \
          | sed -n "${sa_nth}p" | cut -d: -f1 | tr -d ' ')
    if [ -z "$sa_irq" ]; then
        log "SKIP: '$sa_pattern' (#$sa_nth) not found in /proc/interrupts"
        return 1
    fi
    if echo "$sa_mask" > "/proc/irq/$sa_irq/smp_affinity" 2>/dev/null; then
        log "OK: IRQ $sa_irq ($sa_pattern #$sa_nth) -> mask $sa_mask"
    else
        log "FAIL: IRQ $sa_irq ($sa_pattern #$sa_nth) rejected mask (managed IRQ?)"
    fi
}

case "$BOARD" in

    # -------------------------------------------------------------------
    # Securifi Almond 3S (MT7621: 2 physical cores x 2 threads = 4 CPUs)
    #
    # Layout: keep CPU0 for system + Ethernet (routed traffic is handled
    # by the MT7530 switch HW offload and barely touches the CPU anyway),
    # spread USB and the two Wi-Fi radios across the remaining CPUs.
    # -------------------------------------------------------------------
    securifi,almond*|*almond-3s*)
        set_aff "xhci-hcd"  2        # USB          -> CPU1
        set_aff "mt76x2e"   4  1     # Wi-Fi radio1 -> CPU2
        set_aff "mt76x2e"   8  2     # Wi-Fi radio2 -> CPU3
        ;;

    # -------------------------------------------------------------------
    # GL.iNet Flint 2 / MT6000 (MT7986: 4x Cortex-A53)
    #
    # Layout: one hot IRQ source per core.
    #   CPU0 - system + USB (idle in practice)
    #   CPU1 - Ethernet queue #1
    #   CPU2 - Wi-Fi (mt7915e, the hottest IRQ; moved off CPU0)
    #   CPU3 - Ethernet queue #2
    # The full SoC address in the pattern avoids matching "mtk_eth",
    # whose load is negligible and is left untouched, as is crypto.
    # -------------------------------------------------------------------
    glinet,gl-mt6000)
        set_aff "mt7915e"           4        # Wi-Fi       -> CPU2
        set_aff "15100000.ethernet" 2  1     # eth queue 1 -> CPU1
        set_aff "15100000.ethernet" 8  2     # eth queue 2 -> CPU3
        set_aff "xhci-hcd"          1        # USB         -> CPU0
        ;;

    # -------------------------------------------------------------------
    # Routerich AX3000 v1 (MT7981: 2x Cortex-A53)
    #
    # Only two cores, so the goal is just to get the hot sources off
    # CPU0, where everything lands by default:
    #   CPU0 - system + SPI(NAND) + Ethernet queue #1
    #   CPU1 - Wi-Fi (mt7915e, the hottest IRQ) + Ethernet queue #2
    # USB is idle but pinned to CPU0 to keep it away from Wi-Fi.
    # -------------------------------------------------------------------
    routerich,ax3000*)
        set_aff "mt7915e"           2        # Wi-Fi       -> CPU1
        set_aff "15100000.ethernet" 1  1     # eth queue 1 -> CPU0
        set_aff "15100000.ethernet" 2  2     # eth queue 2 -> CPU1
        set_aff "xhci-hcd"          1        # USB         -> CPU0
        ;;

    # -------------------------------------------------------------------
    # Template for future devices:
    #
    # vendor,model)
    #     set_aff "<pattern>" <mask> [match#]
    #     ;;
    # -------------------------------------------------------------------

    *)
        log "No profile for board '$BOARD' - affinity left unchanged"
        exit 0
        ;;
esac

log "Profile for '$BOARD' applied"
